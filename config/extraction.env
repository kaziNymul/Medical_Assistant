# ===========================================
# Local LLM Extraction Configuration
# ===========================================
# Optimized for CPU-only systems with limited RAM

# Model Selection
# Options: google/flan-t5-small, google/flan-t5-base, google/flan-t5-large
EXTRACTION_MODEL=google/flan-t5-base

# Device Configuration
# Options: auto, cpu, cuda, mps
EXTRACTION_DEVICE=cpu

# Memory Optimization
EXTRACTION_LOAD_IN_8BIT=false
EXTRACTION_MAX_LENGTH=1024

# Performance Tuning
EXTRACTION_BATCH_SIZE=1
EXTRACTION_NUM_THREADS=4

# Model Caching
EXTRACTION_CACHE_DIR=/mnt/e/medical_assistant/models
TRANSFORMERS_CACHE=/mnt/e/medical_assistant/models

# Databricks Sync (set your credentials in Vault)
DATABRICKS_SYNC_ENABLED=true
