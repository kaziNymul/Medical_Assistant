# Medical Assistant Environment Configuration
# Copy this file to .env and fill in values

# ======================
# Application Settings
# ======================
APP_NAME=AI Clinical Documentation Assistant
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ======================
# API Settings
# ======================
API_HOST=0.0.0.0
API_PORT=8000

# ======================
# RAG Settings
# ======================
# Embedding model for local mode (Phase 1)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunk settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Vector store path
VECTOR_STORE_PATH=./data/vector_store

# ======================
# LLM Settings (Phase 1 - Local)
# ======================
# For Phase 1, we use a simple extraction approach
# Set to 'local' for Phase 1, 'bedrock' for Phase 2
LLM_PROVIDER=local

# ======================
# AWS Bedrock (Phase 2)
# ======================
# Uncomment and configure for Phase 2
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# BEDROCK_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0

# ======================
# Databricks (Phase 3)
# ======================
# Uncomment and configure for Phase 3
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=your-databricks-token
# DATABRICKS_CATALOG=healthcare_ai
# DATABRICKS_SCHEMA=clinical_docs

# ======================
# HashiCorp Vault Settings
# ======================
# Enable Vault for secrets management (recommended for production)
VAULT_ENABLED=false
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=your-vault-token
VAULT_PATH=secret/data/medical-assistant

# ======================
# Security Settings
# ======================
# Enable PII masking (ALWAYS true in production)
ENABLE_PII_MASKING=true

# Minimum confidence threshold for outputs
MIN_CONFIDENCE_THRESHOLD=0.7

# ======================
# UI Settings
# ======================
UI_ENABLED=true
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
